{
  "services": {
    "rydo-frontend": {
      "root": "frontend"
    },
    "rydo-api": {
      "root": "backend",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "rydo-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "rydo-api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "rydo-api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "rydo-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "rydo-frontend"
      }
    }
  ]
}
